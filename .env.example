# Copy to .env for local runs. NEVER commit .env. In production, set these as Railway variables.

# --- storage: "local" (a folder) or "s3"
SB_STORAGE=local
SB_VAULT_PATH=./examples/vault
# SB_S3_BUCKET=my-second-brain-vault
# SB_S3_PREFIX=
# SB_S3_REGION=us-east-1
# Leave empty to use the bucket's default KMS key. If set, it must be the full key ARN.
# SB_S3_KMS_KEY_ID=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- transport: "stdio" (local Claude Code/Desktop) or "http" (remote, requires auth)
SB_TRANSPORT=stdio
SB_PORT=8000

# --- auth (required for http)
SB_AUTH=google
# Public URL of this server, e.g. https://second-brain-production.up.railway.app
# SB_BASE_URL=
# SB_GOOGLE_CLIENT_ID=
# SB_GOOGLE_CLIENT_SECRET=
# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SB_JWT_SIGNING_KEY=
# Comma-separated. Only these verified Google accounts can use the server.
# SB_ALLOWED_EMAILS=you@example.com
# Persist OAuth clients/tokens across redeploys (e.g. a Railway volume). Encrypted at rest.
# SB_OAUTH_STORAGE_DIR=/data/oauth
# Optional: encryption key for that state. Defaults to one derived from SB_JWT_SIGNING_KEY.
# SB_OAUTH_STORAGE_KEY=
# Open dynamic client registration (POST /register). Off by default; Claude.ai and Claude Code
# don't need it. Turn on only for an MCP client that can't use client ID metadata documents.
# SB_ALLOW_DYNAMIC_CLIENT_REGISTRATION=false

# --- activity stats (Postgres). On by default when a database URL is set; "off" disables them.
# SB_STATS=on
# Railway's Postgres service provides DATABASE_URL; SB_DATABASE_URL takes precedence.
# SB_DATABASE_URL=postgresql://user:password@localhost:5432/second_brain
# SB_STATS_RETENTION_DAYS=730
# Store the text of search queries (off by default).
# SB_STATS_LOG_QUERIES=false
